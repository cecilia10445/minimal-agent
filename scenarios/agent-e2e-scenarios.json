  {
    "id": "DOC-LONG-001",
    "title": "Long document truncation metadata and disclosure",
    "api_required": true,
    "fresh_session": true,
    "cost": "high",
    "tags": ["docs", "long"],
    "setup": [
      {
        "action": "ensure_file",
        "filename": "长文档截断测试.md",
        "content": "dummy"
      },
      {
        "action": "ensure_long_file",
        "filename": "长文档截断测试.md",
        "target_chars": 12000,
        "end_marker": "文档末尾识别码：银色狮子8642"
      }
    ],
    "steps": [
      {
        "input": "读取 长文档截断测试.md",
        "expected_tools": ["read_docs"],
        "forbidden_tools": [],
        "expected_answer_contains": [],
        "expected_answer_not_contains": ["银色狮子8642"],
        "note": "truncated=true means end marker NOT in content. Model must state only partial read."
      },
      {
        "input": "在本地知识库搜索 银色狮子8642",
        "expected_tools": ["search_docs"],
        "forbidden_tools": [],
        "expected_answer_contains": ["长文档截断测试"],
        "expected_answer_not_contains": [],
        "note": "search_docs scans full content, must find end marker."
      }
    ],
    "cleanup": [
      {
        "action": "remove_file",
        "filename": "长文档截断测试.md"
      }
    ]
  },
