  {
    "id": "DOC-FRESHNESS-001",
    "title": "Freshness — list_docs must be re-called even after recent listing",
    "api_required": true,
    "fresh_session": true,
    "cost": "medium",
    "tags": ["docs", "freshness"],
    "setup": [
      {
        "action": "ensure_file",
        "filename": "新鲜度测试文件.md",
        "content": "# Freshness test\nThis file tests dynamic state freshness.\n"
      }
    ],
    "steps": [
      {
        "input": "目前本地知识库有多少个文件？",
        "expected_tools": ["list_docs"],
        "forbidden_tools": [],
        "expected_answer_contains": ["新鲜度测试文件"],
        "note": "First call establishes baseline."
      },
      {
        "action_before": "remove_file",
        "filename": "新鲜度测试文件.md"
      },
      {
        "input": "现在本地知识库还有哪些文档？",
        "expected_tools": ["list_docs"],
        "forbidden_tools": [],
        "expected_answer_not_contains": ["新鲜度测试文件"],
        "note": "Agent MUST re-call list_docs, not rely on previous result."
      }
    ],
    "cleanup": [
      {
        "action": "remove_file",
        "filename": "新鲜度测试文件.md"
      }
    ]
  },
